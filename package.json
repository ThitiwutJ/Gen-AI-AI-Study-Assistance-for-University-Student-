{
  "name": "gen-ai-study-assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/launch.mjs --dev",
    "build": "next build",
    "start": "node scripts/launch.mjs",
    "start:lan": "node scripts/launch.mjs --lan",
    "start:next": "next start -H 127.0.0.1",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check:ai": "node scripts/check-ollama.mjs",
    "mock:ollama": "node scripts/mock-ollama.mjs --port 11435",
    "samples": "python scripts/make-samples.py"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-thai": "^5.3.0",
    "@fontsource/ibm-plex-sans-thai-looped": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "jszip": "^3.10.2",
    "katex": "^0.19.1",
    "lucide-react": "^1.62.0",
    "mammoth": "^1.13.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "description": "Gen AI \u2014 an AI study assistant with local knowledge, powered by local Ollama models.",
  "engines": {
    "node": ">=22.13.0"
  }
}
