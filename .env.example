# Gen AI configuration. Copy this file to .env.local and edit if needed.
# None of these values are secrets. Ollama needs no API key.

# Where your local Ollama runs. Keep it on 127.0.0.1 (this computer only).
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional: preferred chat model. Leave empty to let Gen AI pick from your installed models
# (you can also choose in Settings). Example: gemma3:1b or gemma3:4b
OLLAMA_MODEL=

# Optional: preferred embedding model for semantic search. Leave empty for automatic.
# Example: qwen3-embedding:0.6b (multilingual: English + Thai)
OLLAMA_EMBED_MODEL=

# Context window sent with every request (options.num_ctx). 8192 suits most laptops.
OLLAMA_NUM_CTX=8192

# How long Ollama keeps the model loaded between requests.
OLLAMA_KEEP_ALIVE=10m

# Maximum time for one AI request, in milliseconds (local models can be slow).
AI_REQUEST_TIMEOUT_MS=600000

# Where the database and uploaded files are stored (relative to the project folder).
DATA_DIR=data

# Largest file you can upload, in MB.
MAX_UPLOAD_MB=25

# --- Optional alternative: any OpenAI-compatible server (LM Studio, llama.cpp server, ...) ---
# AI_PROVIDER=openai-compatible
# OPENAI_COMPAT_BASE_URL=http://127.0.0.1:1234/v1
# OPENAI_COMPAT_MODEL=
# OPENAI_COMPAT_EMBED_MODEL=
# OPENAI_COMPAT_API_KEY=
